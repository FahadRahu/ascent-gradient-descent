    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "~0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
