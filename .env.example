# Public browser configuration. Vercel supplies VERCEL_ENV automatically.
VITE_SENTRY_DSN=
VITE_DEPLOY_ENV=development

# Build-only source map upload. Configure these in Vercel project settings.
SENTRY_ORG=
SENTRY_PROJECT=
# Secret: never prefix this with VITE_ or commit a real token.
SENTRY_AUTH_TOKEN=
